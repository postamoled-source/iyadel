{
  "name": "MovieEntry",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "media_type": {
      "type": "string",
      "enum": [
        "movie",
        "tv"
      ],
      "default": "movie"
    },
    "overview": {
      "type": "string"
    },
    "poster_url": {
      "type": "string"
    },
    "backdrop_url": {
      "type": "string"
    },
    "release_year": {
      "type": "string"
    },
    "genres": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "country": {
      "type": "string"
    },
    "language": {
      "type": "string"
    },
    "rating": {
      "type": "number",
      "default": 0
    },
    "trailer_url": {
      "type": "string"
    },
    "watch_url": {
      "type": "string"
    },
    "download_links": {
      "type": "array",
      "default": [],
      "items": {
        "type": "object",
        "properties": {
          "quality": {
            "type": "string"
          },
          "url": {
            "type": "string"
          }
        }
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "published",
        "draft"
      ],
      "default": "published"
    }
  },
  "required": [
    "title"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}